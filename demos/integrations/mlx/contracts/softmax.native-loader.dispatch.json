                    "capability": "simdWidth"
                  },
                  32
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "capability": "maxThreadsPerWorkgroup"
                  },
                  1024
                ]
              }
            ]
          },
          "entryPoint": "block_softmax_float32",
          "workgroupSize": [
            {
              "op": "multiply",
              "args": [
                32,
                {
                  "op": "ceilDiv",
                  "args": [
                    {
                      "op": "ceilDiv",
                      "args": [
                        {
                          "input": "axisSize"
                        },
                        4
                      ]
                    },
                    32
                  ]
                }
              ]
            },
            1,
            1
          ],
          "subgroupWidth": {
            "capability": "simdWidth"
          },
          "dispatch": {
            "workgroupCount": [
              {
                "input": "nRows"
              },
              1,
              1
            ]
          },
          "provenance": {
            "hostFunction": "Softmax::eval_gpu",
            "branch": "block",
            "loopedLimit": 4096,
            "readsPerThread": 4
          }
        }
      ]
    }
