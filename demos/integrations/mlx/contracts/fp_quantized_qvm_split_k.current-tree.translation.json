  "validationContract": {
    "model": "fp_qvm_impl lane by lane on each tid.z's part after adjust_matrix_offsets over the split views: split_D rows, or final_block_size for the last part, with K as the row stride and no global scale, against direct dequantized partial dot products",
    "packing": "least-significant-bit-first code stream per weight row",
    "weights": "K rows of N codes, quantized along N",
    "split": "split_D = ceil(K / split_k), final_block_size = K - (split_k - 1) * split_D; quantized.cpp's views add a split_k batch dimension",
    "hostBuffers": "the fp modes have no biases, so quantized.cpp binds the kernel's fourteen buffers in declaration order",
    "comparison": "exact words",
    "workgroupSize": [
      32,
      2,
      1
    ],
