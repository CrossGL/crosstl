// OpenCL to CrossGL conversion
// Kernel: saxpy
@compute
@host_workgroup_size
fn saxpy(
    f32 a,
    @group(0) @binding(0) var<storage, read_write> x: array<f32>,
    @group(0) @binding(1) var<storage, read_write> y: array<f32>
) {
    var gid: i32 = gl_GlobalInvocationID.x;
    y[gid] = fma(a, x[gid], y[gid]);
}
