#version 450

shader main {
    @glsl_interface_block(out) struct gl_PerVertex {
    vec4 gl_Position;
};

    struct VertexInput {
    vec3 inPos @location(0);
    vec3 inColor @location(1);
    };

    struct VertexOutput {
    vec3 outColor @location(0);
    vec4 gl_Position;
    };

    cbuffer UBO @binding(0) @buffer_layout(std140) {
    mat4 projection;
    mat4 model;
    };

    vertex {
    VertexOutput main(VertexInput input) {
        VertexOutput output;
        output.outColor = input.inColor;
        output.gl_Position = ((projection * model) * vec4(input.inPos, 1.0));
        return output;
    }
    }
}
