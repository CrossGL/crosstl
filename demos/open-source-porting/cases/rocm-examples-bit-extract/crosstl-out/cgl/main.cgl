#pragma cgl_rules(fp_ieee, libm, round_away)
// HIP to CrossGL conversion
// Kernel: bit_extract_kernel
@compute
@stage_entry
@host_workgroup_size
fn bit_extract_kernel(
    @group(0) @binding(0) var<storage, read_write> d_output: array<u32>,
    @group(0) @binding(1) var<storage, read> d_input: array<u32>,
    @group(0) @binding(2) var<uniform> size: u64
) {
    var offset: u64 = gl_GlobalInvocationID.x;
    var stride: u64 = (gl_WorkGroupSize.x * gl_NumWorkGroups.x);
    for (var i: u64 = offset; (i < size); i += stride) {
        d_output[i] = ((d_input[i] >> 8) & 0xfu);
    }
}
