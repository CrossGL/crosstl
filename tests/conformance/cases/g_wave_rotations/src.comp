#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_rotate : require
// Subgroup rotations (GL_KHR_shader_subgroup_rotate) in uniform control flow: by 3 lanes over the subgroup, and by
// 1 lane within aligned clusters of 4.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Inp { int a[]; };
layout(std430, binding = 1) buffer Outp { int o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    int x = a[i];
    o[4u * i] = subgroupRotate(x, 3u);
    o[4u * i + 1u] = subgroupClusteredRotate(x, 1u, 4u);
    o[4u * i + 2u] = subgroupRotate(x, gl_SubgroupSize - 1u);
    o[4u * i + 3u] = int(gl_SubgroupSize);
}
