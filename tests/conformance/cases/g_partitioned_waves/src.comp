#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_NV_shader_subgroup_partitioned : require
// Partitioned reductions and scans (GL_NV_shader_subgroup_partitioned) over the lanes whose keys x & 3 agree.
// The masks come from ballots in uniform control flow, as subgroupPartitionNV(x & 3) would return them.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Inp { int a[]; };
layout(std430, binding = 1) buffer Outp { int o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    int x = a[i];
    int key = x & 3;
    uvec4 b0 = subgroupBallot(key == 0);
    uvec4 b1 = subgroupBallot(key == 1);
    uvec4 b2 = subgroupBallot(key == 2);
    uvec4 b3 = subgroupBallot(key == 3);
    uvec4 m = key == 0 ? b0 : (key == 1 ? b1 : (key == 2 ? b2 : b3));
    o[8u * i] = subgroupPartitionedAddNV(x, m);
    o[8u * i + 1u] = subgroupPartitionedMinNV(x, m);
    o[8u * i + 2u] = subgroupPartitionedMaxNV(x, m);
    o[8u * i + 3u] = subgroupPartitionedXorNV(x, m);
    o[8u * i + 4u] = subgroupPartitionedInclusiveMinNV(x, m);
    o[8u * i + 5u] = subgroupPartitionedExclusiveMaxNV(x, m);
    o[8u * i + 6u] = subgroupPartitionedInclusiveAddNV(x, m);
    o[8u * i + 7u] = int(gl_SubgroupSize);
}
