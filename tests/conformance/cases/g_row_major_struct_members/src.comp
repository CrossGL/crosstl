#version 450
// GLSL 4.60 section 4.4.5: row_major applies to every matrix in the block, including the matrices of structures
// nested in it at any depth. In std430 the row-major mat2x3 of Inner is three 8-byte rows of two floats, so Inner is
// 24 bytes and c starts at byte 32; the row-major mat3x2 k is two 16-byte rows of three floats from byte 48, and L
// is 80 bytes. Every read below goes through that storage.
layout(local_size_x = 64) in;
struct Inner { mat2x3 n; };
struct L { Inner inner; vec4 c; mat3x2 k; };
layout(std430, row_major, binding = 0) readonly buffer Inp { L ls[64]; } inp;
layout(std430, binding = 1) buffer Outp { vec4 o[192]; } outp;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint j = 63u - i;
    mat2x3 n = inp.ls[i].inner.n;
    vec3 col = inp.ls[j].inner.n[1];
    float e = inp.ls[i].k[2].y;
    vec2 kv = inp.ls[i].k * vec3(1.0, 2.0, 3.0);
    outp.o[3u * i] = vec4(n[0], e);
    outp.o[3u * i + 1u] = vec4(col, inp.ls[i].c.w);
    outp.o[3u * i + 2u] = vec4(kv, inp.ls[j].k[0]);
}
