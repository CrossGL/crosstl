#version 450
// GLSL 4.60 section 5.8: an assignment expression has the value of its left operand after the assignment, so a
// parenthesized assignment that is an operand contributes that value, and ?: evaluates only the selected one.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Inp { int a[]; } inp;
layout(std430, binding = 1) buffer Outp { int o[]; } outp;

void main() {
    uint i = gl_GlobalInvocationID.x;
    int x = inp.a[i];
    int b = x;
    int c = (b = b + 1) * 2;
    int d = (b += 3) - 1;
    int e = -(b -= 2);
    int f = (c = c + 1) > 5 ? (d = d * 2) + 1 : (e = e - 7) - 1;
    int g = 10 * (b *= 3);
    uint base = i * 6u;
    outp.o[base] = b;
    outp.o[base + 1u] = c;
    outp.o[base + 2u] = d;
    outp.o[base + 3u] = e;
    outp.o[base + 4u] = f;
    outp.o[base + 5u] = g;
}
