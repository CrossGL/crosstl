#version 450
// GLSL 4.60 section 7.6.2.2: a row_major matrix is stored like an array of its row vectors, so in std430 a
// row-major mat3x2 is two 16-byte rows of three floats and a row-major mat4x2 two rows of four. Every matrix read,
// column read, element read, whole write and compound write below goes through that storage.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Inp { layout(row_major) mat3x2 m[64]; } inp;
layout(std430, binding = 1) buffer Outp { layout(row_major) mat4x2 w[64]; vec4 o[64]; } outp;

void main() {
    uint i = gl_GlobalInvocationID.x;
    mat3x2 a = inp.m[i];
    vec2 col = inp.m[i][2];
    float e = inp.m[i][1][0];
    vec2 mv = inp.m[i] * vec3(1.0, 2.0, 3.0);
    outp.w[i] = mat4x2(a[0], a[1], a[2], col + vec2(e + mv.x + mv.y));
    outp.w[i] += mat4x2(vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(0.5), vec2(0.0));
    outp.o[i] = vec4(outp.w[i][0], outp.w[i][1]);
}
