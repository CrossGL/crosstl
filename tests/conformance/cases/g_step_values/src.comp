#version 450
// Hazard I3: signed increments and decrements used as values wrap at the int32 edges.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Inp { int a[]; };
layout(std430, binding = 1) buffer Outp { int o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    int x = a[i];
    int y = x;
    int z = x;
    int p = y++;
    int q = --z;
    int k = x;
    int stop = x + 2;
    int trips = 0;
    while (k++ != stop && trips < 4) { trips += 1; }
    o[4u * i + 0u] = p + y;
    o[4u * i + 1u] = q;
    o[4u * i + 2u] = trips;
    o[4u * i + 3u] = k;
}
