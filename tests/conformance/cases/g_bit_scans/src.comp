#version 450
// findMSB and findLSB (GLSL 4.60 section 8.8): -1 for zero, and a negative int finds the highest clear bit.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Inp { uint a[]; };
layout(std430, binding = 1) buffer Outp { uint o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = a[i];
    int s = int(x);
    ivec2 pair = findMSB(ivec2(s, ~s));
    ivec3 lows = findLSB(uvec3(x, ~x, x >> 16));
    o[8u * i] = uint(findMSB(x));
    o[8u * i + 1u] = uint(findLSB(x));
    o[8u * i + 2u] = uint(findMSB(s));
    o[8u * i + 3u] = uint(findLSB(s));
    o[8u * i + 4u] = uint(pair.x);
    o[8u * i + 5u] = uint(pair.y);
    o[8u * i + 6u] = uint(lows.y);
    o[8u * i + 7u] = uint(lows.z);
}
