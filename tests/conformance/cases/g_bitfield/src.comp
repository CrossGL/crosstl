#version 450
// bitfieldExtract and bitfieldInsert (GLSL 4.60 section 8.8) with run-time offsets and widths, 0 and 32 included.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Inp { uint a[]; };
layout(std430, binding = 1) buffer Outp { uint o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint v = a[i];
    int offset = int(i % 33u);
    int bits = int((i * 7u) % 33u);
    if (offset + bits > 32) {
        bits = 32 - offset;
    }
    o[4u * i] = bitfieldExtract(v, offset, bits);
    o[4u * i + 1u] = uint(bitfieldExtract(int(v), offset, bits));
    o[4u * i + 2u] = bitfieldInsert(v, ~v, offset, bits);
    o[4u * i + 3u] = uint(bitfieldInsert(int(v), int(i * 2654435761u), offset, bits));
}
