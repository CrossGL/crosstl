// __syncwarp orders the global memory accesses of the lanes it waits for: each lane reads the storage-buffer slot
// its neighbour wrote before the barrier, and the second barrier keeps a lane from overwriting a slot its neighbour
// still reads. The 48-invocation workgroup holds a full warp and a 16-lane partial warp.
shader WarpSyncMemory {
    compute hazard {
        layout(local_size_x = 48, local_size_y = 1, local_size_z = 1) in;

        buffer int* inp;
        buffer int* outp;

        void main() {
            uint i = gl_GlobalInvocationID.x;
            outp[i * 2u] = inp[i] * 3 + 7;
            __syncwarp();
            int other = outp[(i ^ 1u) * 2u];
            __syncwarp();
            outp[i * 2u] = other;
            outp[i * 2u + 1u] = inp[i];
        }
    }
}
