#version 450
// Hazard I2: signed multiplication overflow followed by division.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Inp { int a[]; };
layout(std430, binding = 1) buffer Outp { int o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    int x = a[i];
    int y = x * 2;
    o[i] = (y / 2 == x) ? 1 : 0;
}
