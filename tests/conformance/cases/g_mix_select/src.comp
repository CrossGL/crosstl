#version 450
// mix with a boolean selector selects (GLSL 4.60 section 8.3): an infinite or NaN operand that is not selected
// must not reach the result.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Inp { float a[]; };
layout(std430, binding = 1) buffer Outp { float o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    float x = a[2u * i];
    float y = a[2u * i + 1u];
    vec2 r = mix(vec2(x, y), vec2(y, x), bvec2(i % 3u == 0u, i % 3u == 1u));
    o[3u * i] = mix(x, y, (i & 1u) == 1u);
    o[3u * i + 1u] = r.x;
    o[3u * i + 2u] = r.y;
}
