#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer In { float a[]; };
layout(std430, binding = 1) buffer Out { float o[]; };
void main() { uint i = gl_GlobalInvocationID.x;
  mat2 m = mat2(a[i], 1.0, 2.0, 3.0);
  o[i] = (isnan(a[i]) ? 1.0 : 0.0) + (isinf(a[i]) ? 2.0 : 0.0) + transpose(m)[0][1] + inverse(m)[0][0]; }
